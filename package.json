    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^3.0.17",
    "@types/node": "^22.10.2",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^5.7.2",
    "vitest": "^3.2.1"
  }
}
