{
  "name": "gemini-interactions-provider",
  "version": "0.1.0",
  "private": true,
  "description": "LanguageModelV3 wrapper that routes Gemini traffic through the Interactions API with automatic previous_interaction_id state chaining.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
